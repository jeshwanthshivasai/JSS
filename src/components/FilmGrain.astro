---
---
<div class="pointer-events-none fixed inset-0 z-50 h-[100vh] w-[100vw] opacity-30 mix-blend-overlay">
  <svg class="h-full w-full">
    <filter id="noiseFilter" x="0" y="0" width="100%" height="100%">
      <feTurbulence 
        type="fractalNoise" 
        baseFrequency="0.75" 
        numOctaves="3" 
        stitchTiles="stitch" 
      />
    </filter>
    <!-- Animate the noise by translating the rect slightly on an infinite loop -->
    <rect width="100%" height="100%" filter="url(#noiseFilter)">
      <animateTransform
        attributeName="transform"
        type="translate"
        values="0,0; -10,-10; 10,10; -5,5; 0,0"
        keyTimes="0; 0.25; 0.5; 0.75; 1"
        dur="0.2s"
        repeatCount="indefinite"
      />
    </rect>
  </svg>
</div>

<style>
  /* SVG noise can be heavy, ensuring hardware acceleration */
  div {
    transform: translateZ(0);
    will-change: transform;
  }
</style>

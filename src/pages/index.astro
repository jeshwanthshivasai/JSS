---
import Layout from '../layouts/Layout.astro';
import HeroScene from '../components/3D/HeroScene.tsx';
import EngineProjects from '../components/Engine/Projects.tsx';
import SplitView from '../components/SplitView.tsx';
import Footer from '../components/Footer.astro';
---

<Layout title="Jeshwanth - Product Designer & UI Engineer">
	<main class="w-full relative z-10">
		<HeroScene client:load />

		<div id="engine">
			<EngineProjects client:visible />
		</div>

		<div id="sketchbook">
			{/* The Sketchbook section is embedded directly inside the SplitView's right panel */}
			<SplitView client:visible />
		</div>

		<div id="contact">
			<Footer />
		</div>
	</main>
</Layout>
